{
  "name": "maelle",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Maelle, the AI business superbrain. First area: AnastasAI, customer support for InstaRadar.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "tsx scripts/test-db.ts",
    "eval": "vitest run --config evals/vitest.config.ts",
    "db:local": "tsx scripts/local-pg.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:types": "tsx scripts/db-types.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "fonts:fetch": "tsx scripts/fonts-fetch.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@linear/sdk": "^96.0.0",
    "@notionhq/client": "^5.26.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@supabase/supabase-js": "^2.117.2",
    "@vueuse/core": "^14.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "imapflow": "^2.1.0",
    "mailparser": "^3.9.29",
    "nodemailer": "^10.0.11",
    "nuxt": "^4.5.2",
    "pg": "^8.16.0",
    "reka-ui": "^2.10.5",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.30.0",
    "happy-dom": "^20.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.6.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "vue-demi",
      "supabase",
      "@parcel/watcher",
      "sharp"
    ]
