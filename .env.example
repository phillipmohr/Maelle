# Maelle environment variables. Names are binding (IRDR-454 section 8).
# Copy to .env for local development. Never commit real values.

# --- Maelle's own Supabase project ---------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL of the same project (Dashboard → Connect → URI, or the
# local CLI stack: postgresql://postgres:postgres@127.0.0.1:54322/postgres).
# Used by the server (pg pool) and by pnpm db:migrate / db:seed / db:reset / db:types.
# On Vercel use the Supabase transaction pooler URL (port 6543) with ?sslmode=require.
SUPABASE_DB_URL=

# --- Auth -----------------------------------------------------------------
# The only email that may sign in (magic link or Google). Everything else is
# rejected server-side and by a database trigger on auth.users.
ALLOWED_USER_EMAIL=you@example.com
# Development only. Skips the session check so the UI can be explored against
# seed data without a Supabase project. Ignored in production builds.
AUTH_DISABLED=false

# --- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Mail (support@instaradar.app) ----------------------------------------
SUPPORT_MAILBOX=support@instaradar.app
# Provider credentials are named by the mail ticket (IRDR-455); it documents
# them in README.md and appends them here.

# --- Stripe (two restricted keys) -----------------------------------------
# Read-only restricted key, used by the agent's research tools only.
STRIPE_READ_KEY=
# Restricted key with write on Subscriptions, Refunds, Coupons, Promotion codes
# and Invoices; used by the executor only.
STRIPE_WRITE_KEY=

# --- InstaRadar Supabase (Postgres) ---------------------------------------
# Role with SELECT only (agent research).
INSTARADAR_DB_READ_URL=
# Role limited to the executor's writes.
INSTARADAR_DB_WRITE_URL=

# --- Vercel (InstaRadar runtime logs) -------------------------------------
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_INSTARADAR_PROJECT_ID=

# --- Notion ---------------------------------------------------------------
# Integration with "read content" only (agent knowledge).
NOTION_READ_TOKEN=
# Integration with read + insert content, no update (learning loop drafts).
NOTION_WRITE_TOKEN=

# --- Linear ---------------------------------------------------------------
LINEAR_READ_API_KEY=
LINEAR_WRITE_API_KEY=
LINEAR_TEAM_ID=
LINEAR_WEBHOOK_SECRET=

# --- Jobs, cron, notifications --------------------------------------------
# Shared secret that cron and internal job routes must present.
CRON_SECRET=
# Where alerts and the daily digest go.
NOTIFY_EMAIL=

# --- Deployment -----------------------------------------------------------
# Public URL of this deployment (used in links inside notification emails).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- IRDR-459: autonomy, notifications, learning loop --------------------
# Small Claude model that condenses a final reply into a Knowledge Base draft
# (learning loop). Falls back to a deterministic condensation without ANTHROPIC_API_KEY.
AGENT_SMALL_MODEL=claude-sonnet-5

# --- Executor (IRDR-457) -----------------------------------------------------
# Account deletion removes the auth user of the InstaRadar Supabase project (not Maelle's own),
# so the executor needs that project's URL and service role key.
INSTARADAR_SUPABASE_URL=
INSTARADAR_SUPABASE_SERVICE_ROLE_KEY=
# InstaRadar table and column names the executor writes to (defaults match docs/instaradar/).
INSTARADAR_DB_SCHEMA=public
INSTARADAR_BLOCKED_PROFILES_TABLE=blocked_profiles
INSTARADAR_BLOCKED_HANDLE_COLUMN=username
INSTARADAR_BLOCKED_REASON_COLUMN=reason
INSTARADAR_BLOCKED_SOURCE_COLUMN=source
INSTARADAR_TRACKED_PROFILES_TABLE=tracked_profiles
INSTARADAR_TRACKED_HANDLE_COLUMN=username
# Tables holding a user's rows, deleted in this order on account deletion: table:column,table:column
INSTARADAR_USER_TABLES=tracked_profiles:user_id,profiles:id
# Linear team for new issues when LINEAR_TEAM_ID is empty (matched by name).
LINEAR_TEAM_NAME=InstaRadar
# Outside production the executor uses in-memory fakes for every external system whose credential is
# missing. Set true to force the fakes (never in production), false to forbid them.
EXECUTOR_USE_FAKES=
# The fakes start with the design's sample objects (Tom's sub_1PzT8c, Priya's INS-198, …) so the seed
# tickets can be approved in nuxt dev. Set false for empty fakes.
EXECUTOR_SEED_FAKES=

# --- Agent (IRDR-456) -----------------------------------------------------
# Models: the agent run uses the most capable model, the consistency check a smaller one.
AGENT_MODEL=claude-fable-5-1
AGENT_SMALL_MODEL=claude-sonnet-5
# Table and column names of the InstaRadar database as a JSON object (partial overrides of the
# defaults in server/agent/config.ts, which are assumptions until checked against the InstaRadar repo),
# e.g. {"users":{"table":"public.profiles","email":"email"}}
INSTARADAR_TABLES=
# Where the agent reads InstaRadar runtime logs: "api" (Vercel runtime logs endpoint, default) or
# "drain" (the vercel_logs table fed by a Vercel log drain, see README "Vercel logs").
VERCEL_LOGS_SOURCE=api
# Tuning (defaults in parentheses): model round trips per run (16), per-source research timeout in
# ms (20000), in-process cache of the Notion knowledge in ms (300000).
AGENT_MAX_ITERATIONS=
AGENT_SOURCE_TIMEOUT_MS=
KNOWLEDGE_CACHE_TTL_MS=

# --- Mail provider (IRDR-455) -----------------------------------------------
# gmail | imap | fake. Empty: gmail when GMAIL_* is set, imap when IMAP_HOST is set, else fake.
# Find out which one hosts the mailbox with `dig MX instaradar.app` (see README "Mail and jobs").
MAIL_PROVIDER=
# Display name of outgoing replies (customer-facing, no em dashes).
MAIL_FROM_NAME=Anastasia (InstaRadar Support)
# Messages handled per fetch run, days to look back when there is no cursor yet, mark fetched
# mail as read in the mailbox, minutes after which a stuck send is taken over.
MAIL_FETCH_LIMIT=50
MAIL_BOOTSTRAP_DAYS=1
MAIL_MARK_READ=false
MAIL_STUCK_SEND_MINUTES=5
# Dev only: the fake provider ingests .eml files dropped into this folder (sent mail lands in <dir>/sent).
MAIL_FAKE_DIR=
# Gmail API (Google Workspace). Either an OAuth client + refresh token of the mailbox ...
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# ... or a service account JSON (one line) with domain-wide delegation impersonating the mailbox.
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_IMPERSONATE_USER=support@instaradar.app
# IMAP + SMTP (any other host). IMAP_SECURE defaults to true on 993, SMTP_SECURE to true on 465.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SECURE=
# Sent folder path; detected through the \Sent special-use flag when empty. Set IMAP_APPEND_SENT=false
# when the SMTP server files sent mail itself (Gmail SMTP does).
IMAP_SENT_FOLDER=
IMAP_APPEND_SENT=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=

# --- Job runner (IRDR-455) ---------------------------------------------------
# Wall-clock budget of one /api/cron/tick invocation; keep it below the Vercel function max duration.
JOBS_TICK_BUDGET_MS=270000
# Long jobs (agent runs, 1 to 3 minutes) are only claimed while this much budget remains.
JOBS_LONG_JOB_RESERVE_MS=200000
# Budget of one /api/cron/fetch-mail invocation.
JOBS_FETCH_LANE_BUDGET_MS=50000
# Linear team whose completed issues create release notification tickets (LINEAR_TEAM_ID above wins
# when set; the key is matched against data.team.key or the identifier prefix).
LINEAR_TEAM_KEY=IRDR
