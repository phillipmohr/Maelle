# Maelle: secrets and per-environment values only. Everything else (who signs in, the mailbox and
# its hosts, the Linear team, the InstaRadar project and tables, models, tuning) is hardcoded in
# shared/config.ts. Copy to .env locally; on Vercel add these as environment variables.

# --- Maelle's own Supabase project -----------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres URL for the server (pg). Locally the session pooler (port 5432); on Vercel the transaction
# pooler (port 6543) with ?sslmode=require.
SUPABASE_DB_URL=

# --- Support mailbox: support@instaradar.app on Namecheap Private Email -------
# The one password for IMAP and SMTP (hosts and ports are in shared/config.ts). Unset = in-memory fake.
MAIL_PASSWORD=

# --- Claude ------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Stripe (two restricted keys, see README "Credentials") ---------------------
STRIPE_READ_KEY=
STRIPE_WRITE_KEY=

# --- InstaRadar (the app Maelle supports) --------------------------------------
# SELECT-only Postgres role (agent research) and the executor role (docs/instaradar/executor-role.sql).
INSTARADAR_DB_READ_URL=
INSTARADAR_DB_WRITE_URL=
# Service role key of the InstaRadar Supabase project (account deletion through the Auth admin API).
INSTARADAR_SUPABASE_SERVICE_ROLE_KEY=
# Read runtime logs of the InstaRadar Vercel project.
VERCEL_API_TOKEN=

# --- Notion ------------------------------------------------------------------
# Read content only (agent, playbook) and read + insert content, no update (learning loop).
NOTION_READ_TOKEN=
NOTION_WRITE_TOKEN=

# --- Linear (team InstaRadar) --------------------------------------------------
LINEAR_READ_API_KEY=
LINEAR_WRITE_API_KEY=
# Signing secret of the Linear webhook (Settings → API → Webhooks) that posts to /api/webhooks/linear.
LINEAR_WEBHOOK_SECRET=

# --- Cron --------------------------------------------------------------------
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/tick and /api/cron/fetch-mail.
CRON_SECRET=
