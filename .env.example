# Maelle: secrets only. Everything else (the Supabase project URL and publishable key, who signs in,
# the mailbox and its hosts, the Linear team, the InstaRadar project and tables, models, tuning) is
# hardcoded in shared/config.ts. Copy to .env locally; on Vercel add these as environment variables.

# =============================================================================
# Required for a first deploy
# =============================================================================

# Maelle's own Supabase project. Easiest: connect the Vercel project to the Supabase project
# (Vercel → Integrations → Supabase); it then sets POSTGRES_URL and SUPABASE_SERVICE_ROLE_KEY by
# itself and you type nothing. Manually: Supabase dashboard → Connect → "Transaction pooler" URI
# (port 6543, with your database password) and Project Settings → API keys → the secret key.
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password of support@instaradar.app (Namecheap Private Email; used for IMAP and SMTP). Unset =
# in-memory fake mailbox.
MAIL_PASSWORD=

# Claude (the agent, the consistency check, the learning loop). Unset = runs fail with a clear error.
ANTHROPIC_API_KEY=

# Any long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to the cron routes.
CRON_SECRET=

# =============================================================================
# Optional: each one switches on a single integration. Leave empty until you want it; without a key
# that research source is reported as unavailable and that action says "not configured".
# =============================================================================

# Stripe: two restricted keys (read-only for research, write on subscriptions/refunds/coupons/invoices
# for the executor), see README "Credentials".
STRIPE_READ_KEY=
STRIPE_WRITE_KEY=

# InstaRadar database: a SELECT-only Postgres role (agent research) and the executor role from
# docs/instaradar/executor-role.sql (remove from tracking, delete account).
INSTARADAR_DB_READ_URL=
INSTARADAR_DB_WRITE_URL=
# Service role key of the InstaRadar Supabase project (delete the auth user on account deletion).
INSTARADAR_SUPABASE_SERVICE_ROLE_KEY=

# Vercel token that can read runtime logs of the InstaRadar project (agent research).
VERCEL_API_TOKEN=

# Notion: read content only (agent knowledge, playbook) and read + insert, no update (learning loop).
NOTION_READ_TOKEN=
NOTION_WRITE_TOKEN=

# Linear: read (agent finds existing issues), write (executor creates issues and comments), and the
# signing secret of the webhook (Settings → API → Webhooks) that posts to /api/webhooks/linear.
LINEAR_READ_API_KEY=
LINEAR_WRITE_API_KEY=
LINEAR_WEBHOOK_SECRET=
